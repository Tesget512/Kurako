<?xml version="1.0" encoding="utf-8"?>
<!-- Same rule as backup_rules.xml, for Android 12+ (data extraction). The
     Keystore-held key never transfers, so backing the secure-store file up
     is pointless and only risks stale state after a device migration. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
