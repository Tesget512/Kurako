#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/ios/build/
/macos/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets — real OAuth credentials, never commit. Use secrets.rs.example as the
# template (see rust/src/secrets.rs.example).
/rust/src/secrets.rs

# Inno Setup installer output
/dist/

# Claude Code local settings (machine-specific paths, permissions)
/.claude/

# Android build artifacts and local config
/android/build/
/android/.gradle/
/android/.kotlin/
/android/app/build/
/android/local.properties
/android/key.properties
/android/**/GeneratedPluginRegistrant.java

# Runtime header cache generated by the vendored media_kit_video package.
/third_party/media_kit_video/common/darwin/.cache/
