// Template for Bangumi OAuth application credentials.
//
// SETUP: copy this file to `secrets.rs` in the same directory and fill in the
// values from your Bangumi developer app (https://bgm.tv → 开发者平台 → 应用管理).
// Set that application's one callback URL to `kurako://oauth/callback`.
// `secrets.rs` is git-ignored so real credentials never enter version control.
//
//   cp rust/src/secrets.rs.example rust/src/secrets.rs
//
// The desktop app is an OAuth "public client" — the secret cannot be kept truly
// confidential in a distributed binary, but keeping it out of the public repo
// avoids casual scraping and lets each fork use its own app.
pub const OAUTH_CLIENT_ID: &str = "your_bangumi_app_id";
pub const OAUTH_CLIENT_SECRET: &str = "your_bangumi_app_secret";
