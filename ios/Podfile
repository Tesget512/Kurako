platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

rust_bin_candidates = [
  ENV['RUSTUP_BIN'],
  File.join(Dir.home, '.cargo', 'bin'),
  '/opt/homebrew/opt/rustup/bin',
  '/usr/local/opt/rustup/bin',
].compact
rust_bin = rust_bin_candidates.find do |candidate|
  File.executable?(File.join(candidate, 'cargo')) &&
    File.executable?(File.join(candidate, 'rustc'))
end
unless rust_bin
  raise 'Rust toolchain not found. Install rustup and ensure cargo/rustc are available.'
end
rustup_home = ENV.fetch('RUSTUP_HOME', File.join(Dir.home, '.rustup'))
cargo_home = ENV.fetch('CARGO_HOME', File.join(Dir.home, '.cargo'))

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  legacy_image_picker_targets = %w[
    DKImagePickerController
    DKPhotoGallery
    SwiftyGif
  ]
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Keep pods aligned with the app's iOS 15 floor. Plugins such as
      # file_picker_darwin use iOS 14+ APIs even though their own podspecs
      # still advertise older deployment targets.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      # No Flutter plugin uses App Intents. Suppress Xcode's empty metadata
      # pass, which otherwise reports one warning for each CocoaPods target.
      config.build_settings['EXTRACT_APPINTENTS_METADATA'] = 'NO'
      config.build_settings['PUB_HOSTED_URL'] = 'https:/$()/pub.flutter-io.cn'
      config.build_settings['FLUTTER_STORAGE_BASE_URL'] = 'https:/$()/storage.flutter-io.cn'
      config.build_settings['PATH'] = "$(inherited):#{rust_bin}"
      config.build_settings['CARGO'] = File.join(rust_bin, 'cargo')
      config.build_settings['RUSTC'] = File.join(rust_bin, 'rustc')
      config.build_settings['RUSTUP_HOME'] = rustup_home
      config.build_settings['CARGO_HOME'] = cargo_home
      if legacy_image_picker_targets.include?(target.name)
        # file_picker still depends on these archived/legacy Swift pods. Keep
        # their deprecation and Swift-concurrency warnings out of Runner's
        # Issues list without suppressing warnings from Kurako or other pods.
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
      end
    end
    if target.name == 'volume_controller'
      # The upstream pod's source glob includes an unused template privacy
      # manifest as a compile source rather than a resource.
      target.source_build_phase.files.each do |file|
        next unless file.file_ref&.path&.end_with?('PrivacyInfo.xcprivacy')
        file.remove_from_project
      end
    end
  end
end
